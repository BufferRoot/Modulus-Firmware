{
  "version": 1,
  "_comment": "Full portable pipeline for a new machine WITHOUT ~/.cursor/hooks.json. Rename to ../hooks.json or merge. On this PC global hooks already cover RTK + Token Savior + Evolver — use project hooks.json (session-pipeline only) to avoid double-fire.",
  "hooks": {
    "preToolUse": [
      {
        "command": "rtk hook cursor",
        "matcher": "Shell"
      }
    ],
    "postToolUse": [
      {
        "command": "C:\\Users\\BEAST MODE\\scoop\\apps\\python313\\current\\python.exe C:\\Users\\BEAST MODE\\AppData\\Roaming\\Python\\Python313\\site-packages\\token_savior\\hooks\\tool_capture_hook.py",
        "matcher": "Shell|Read|Grep|mcp__token-savior-recall__search_codebase|mcp__token-savior-recall__get_function_source",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/evolver-session-start.js",
        "timeout": 3
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/session-pipeline.ps1",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/evolver-signal-detect.js",
        "matcher": "Write",
        "timeout": 2
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/evolver-session-end.js",
        "timeout": 8,
        "loop_limit": 1
      }
    ]
  }
}
