{
  "mcpServers": {
    "ruflo": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "ruflo@latest", "mcp", "start"],
      "cwd": "${workspaceFolder}",
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical",
        "CLAUDE_FLOW_MAX_AGENTS": "8",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      }
    },
    "zig-mcp": {
      "command": "C:\\Users\\BEAST MODE\\AppData\\Local\\zig-mcp\\zig-out\\bin\\zig-mcp.exe",
      "args": [
        "--workspace",
        "${workspaceFolder}",
        "--allow-command-tools"
      ],
      "disabled": false,
      "_setup": "Build zig-mcp per .agents/skills/zig-build/SKILL.md; install ZLS"
    },
    "zigars": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": [
        "-y",
        "@zigars/mcp@0.2.0",
        "--workspace",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "npm_config_update_notifier": "false"
      },
      "disabled": false,
      "_source": "https://mcpmarket.com/server/zigars — structured diagnostics + preview edits"
    },
    "fallow": {
      "command": "node",
      "args": ["${workspaceFolder}/node_modules/fallow/bin/fallow-mcp"],
      "cwd": "${workspaceFolder}",
      "env": {
        "FALLOW_AGENT_SOURCE": "cursor"
      },
      "disabled": false,
      "_setup": "npm install (devDep fallow); reload Cursor window after first install"
    }
  }
}
